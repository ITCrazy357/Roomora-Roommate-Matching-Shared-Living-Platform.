# All environment files stay local, including example/template variants.
.env*
*.env
*.env.*

# Dependencies and build output.
/node_modules/
/dist/
/build/
*.tsbuildinfo
*.tsbuildinfo.*

# Regenerated by Prisma CLI. Keep prisma/schema.prisma and migrations tracked.
/generated/prisma/
/src/generated/prisma/

# Test reports and caches.
/coverage/
/.nyc_output/
/.cache/
/.turbo/
/test-results/

# Runtime files and local tools.
*.log
*.pid
*.pid.lock
/tmp/
/temp/
/.tmp/
/.agents/
/.claude/
/.codex/
/.windsurf/

# Local credentials and operating-system metadata.
*.pem
*.key
*.p12
*.pfx
.DS_Store
Thumbs.db
Desktop.ini
