generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PASSWORD_RESET_GRANT
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum SleepSchedule {
  EARLY_BIRD
  FLEXIBLE
  NIGHT_OWL
}

enum SmokingPreference {
  NO_SMOKING
  OUTDOOR_ONLY
  SMOKER
}

enum PetPreference {
  NO_PETS
  PET_FRIENDLY
  HAS_PETS
}

enum QuietLevel {
  QUIET
  BALANCED
  SOCIAL
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  CLOSED
}

enum ListingType {
  ROOMMATE
  ROOM_RENTAL
  ROOM_WANTED
}

enum HouseInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum HouseEventType {
  CREATED
  INVITED
  JOINED
  LEFT
  OWNER_TRANSFERRED
  INVITE_REVOKED
}

enum Amenity {
  FURNISHED
  AIR_CONDITIONER
  WASHING_MACHINE
  PARKING
  WIFI
  KITCHEN
  BALCONY
  PRIVATE_BATHROOM
  HOT_WATER
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum UserReportReason {
  SPAM
  HARASSMENT
  SCAM
  INAPPROPRIATE
  OTHER
}

enum UserReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ExpenseStatus {
  ACTIVE
  SETTLED
  ADJUSTMENT_REQUIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum ExpenseSplitMode {
  EQUAL
  CUSTOM
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  WATER
  INTERNET
  GROCERIES
  HOUSEHOLD
  OTHER
}

enum HouseActivityKind {
  CHORE
  SHOPPING
}

enum HouseActivityStatus {
  OPEN
  DONE
  CANCELLED
}

enum RecurringDraftStatus {
  PENDING
  CONFIRMED
  SKIPPED
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  role              UserRole  @default(USER)
  email             String    @unique @db.VarChar(320)
  passwordHash      String?   @map("password_hash") @db.VarChar(255)
  emailVerifiedAt   DateTime? @map("email_verified_at")
  lastActiveAt      DateTime? @map("last_active_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lockedAt          DateTime? @map("locked_at")
  lockReason        String?   @map("lock_reason") @db.VarChar(1000)
  moderationVersion Int       @default(1) @map("moderation_version")

  profile             Profile?
  sessions            Session[]
  authTokens          AuthToken[]
  authOtps            AuthOtp[]
  googleAccount       GoogleAccount?
  listings            Listing[]           @relation("ListingOwner")
  savedListings       SavedListing[]
  listingReviews      ListingReview[]
  sentConnections     Connection[]        @relation("ConnectionSender")
  receivedConnections Connection[]        @relation("ConnectionReceiver")
  connectionAttempts  ConnectionAttempt[]
  blockedUsers        UserBlock[]         @relation("Blocker")
  blockedBy           UserBlock[]         @relation("BlockedUser")
  sentReports         UserReport[]        @relation("Reporter")
  receivedReports     UserReport[]        @relation("ReportedUser")
  messages            Message[]
  notifications       Notification[]
  ownedHouses         House[]             @relation("HouseOwner")
  houseMembers        HouseMember[]
  houseEvents         HouseEvent[]        @relation("HouseEventUser")
  houseActions        HouseEvent[]        @relation("HouseEventActor")
  houseAnnouncements  HouseAnnouncement[]

  createdExpenses     Expense[]             @relation("ExpenseCreator")
  expenseAdjustments  ExpenseAdjustment[]   @relation("ExpenseAdjustmentCreator")
  expenseCorrections  ExpenseCorrection[]
  houseParticipants   HouseParticipant[]
  houseMessages       HouseMessage[]
  housePollVotes      HousePollVote[]
  recordedPayments    DebtPayment[]         @relation("PaymentRecorder")
  confirmedPayments   DebtPayment[]         @relation("PaymentConfirmer")
  houseActivities     HouseActivity[]       @relation("ActivityCreator")
  completedActivities HouseActivity[]       @relation("ActivityCompleter")
  recurringExpenses   RecurringExpense[]
  adminActions        AdminAction[]
  refundActions       ServiceRefundAction[]
  systemAnnouncements SystemAnnouncement[]
  serviceOrders       ServiceOrder[]

  @@index([role, lockedAt, createdAt])
  @@map("users")
}

model Listing {
  id                String             @id @default(uuid()) @db.Uuid
  boostUntil        DateTime?          @map("boost_until")
  postingRound      Int                @default(1) @map("posting_round")
  serviceOrders     ServiceOrder[]
  boosts            ListingBoost[]
  appointments      Appointment[]
  ownerId           String             @map("owner_id") @db.Uuid
  status            ListingStatus      @default(DRAFT)
  type              ListingType        @default(ROOMMATE)
  hasRoom           Boolean            @default(true) @map("has_room")
  deletedAt         DateTime?          @map("deleted_at")
  isFull            Boolean            @default(false) @map("is_full")
  version           Int                @default(1)
  title             String             @default("") @db.VarChar(150)
  description       String             @default("") @db.VarChar(5000)
  rent              Int?
  deposit           Int                @default(0)
  electricityCost   Int                @default(0) @map("electricity_cost")
  waterCost         Int                @default(0) @map("water_cost")
  internetCost      Int                @default(0) @map("internet_cost")
  otherCost         Int                @default(0) @map("other_cost")
  costNote          String             @default("") @map("cost_note") @db.VarChar(500)
  area              Int?
  availableSlots    Int                @default(1) @map("available_slots")
  currentResidents  Int                @default(0) @map("current_residents")
  desiredResidents  Int?               @map("desired_residents")
  availableFrom     DateTime?          @map("available_from") @db.Date
  provinceCode      String?            @map("province_code") @db.VarChar(2)
  provinceName      String?            @map("province_name") @db.VarChar(100)
  wardCode          String?            @map("ward_code") @db.VarChar(5)
  wardName          String?            @map("ward_name") @db.VarChar(100)
  privateAddress    String             @default("") @map("private_address") @db.VarChar(300)
  // Only a coarse area center is stored; never precise room coordinates.
  latitude          Float?
  longitude         Float?
  amenities         Amenity[]          @default([])
  roommateNote      String             @default("") @map("roommate_note") @db.VarChar(1000)
  smokingPreference SmokingPreference? @map("smoking_preference")
  petPreference     PetPreference?     @map("pet_preference")
  quietLevel        QuietLevel?        @map("quiet_level")
  rejectionReason   String?            @map("rejection_reason") @db.VarChar(1000)
  submittedAt       DateTime?          @map("submitted_at")
  publishedAt       DateTime?          @map("published_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  owner   User            @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  photos  ListingPhoto[]
  saves   SavedListing[]
  reviews ListingReview[]

  @@index([status, publishedAt, id])
  @@index([status, type, publishedAt, id])
  @@index([status, provinceCode, wardCode, rent])
  @@index([ownerId, updatedAt])
  @@index([amenities], type: Gin)
  @@index([status, boostUntil])
  @@map("listings")
}

model House {
  id            String              @id @default(uuid()) @db.Uuid
  ownerId       String              @map("owner_id") @db.Uuid
  name          String              @db.VarChar(120)
  address       String              @default("") @db.VarChar(300)
  description   String              @default("") @db.VarChar(1000)
  rules         String              @default("") @db.VarChar(3000)
  closedAt      DateTime?           @map("closed_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  owner         User                @relation("HouseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members       HouseMember[]
  invites       HouseInvite[]
  events        HouseEvent[]
  announcements HouseAnnouncement[]

  expenses            Expense[]
  expenseCorrections  ExpenseCorrection[]
  debtPayments        DebtPayment[]
  participants        HouseParticipant[]
  messages            HouseMessage[]
  lastMessageNumber   Int                  @default(0) @map("last_message_number")
  activities          HouseActivity[]
  recurringExpenses   RecurringExpense[]
  costSharingSettings CostSharingSetting[]
  costSharingPeriods  CostSharingPeriod[]

  @@index([ownerId])
  @@map("houses")
}

model HouseMember {
  houseId  String    @map("house_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")
  house    House     @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([houseId, userId])
  // A partial unique index in 20260929010000_one_active_house_per_user
  // allows only one row with left_at = NULL for each user.
  @@index([userId, leftAt])
  @@map("house_members")
}

model HouseInvite {
  id        String            @id @default(uuid()) @db.Uuid
  houseId   String            @map("house_id") @db.Uuid
  email     String            @db.VarChar(320)
  status    HouseInviteStatus @default(PENDING)
  expiresAt DateTime          @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  house     House             @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@unique([houseId, email])
  @@index([email, status, expiresAt])
  @@map("house_invites")
}

model HouseEvent {
  id        String         @id @default(uuid()) @db.Uuid
  houseId   String         @map("house_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  actorId   String         @map("actor_id") @db.Uuid
  type      HouseEventType
  createdAt DateTime       @default(now()) @map("created_at")
  house     House          @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user      User           @relation("HouseEventUser", fields: [userId], references: [id], onDelete: Restrict)
  actor     User           @relation("HouseEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([houseId, createdAt])
  @@map("house_events")
}

model HouseAnnouncement {
  id        String   @id @default(uuid()) @db.Uuid
  houseId   String   @map("house_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  text      String   @db.VarChar(2000)
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([houseId, createdAt])
  @@map("house_announcements")
}

model ListingPhoto {
  id        String  @id @default(uuid()) @db.Uuid
  listingId String  @map("listing_id") @db.Uuid
  url       String  @db.VarChar(2048)
  publicId  String  @unique @map("public_id") @db.VarChar(255)
  position  Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
  @@map("listing_photos")
}

model SavedListing {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId, createdAt])
  @@map("saved_listings")
}

model ListingReview {
  id        String        @id @default(uuid()) @db.Uuid
  listingId String        @map("listing_id") @db.Uuid
  adminId   String        @map("admin_id") @db.Uuid
  decision  ListingStatus
  reason    String?       @db.VarChar(1000)
  version   Int
  createdAt DateTime      @default(now()) @map("created_at")
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  admin     User          @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt])
  @@map("listing_reviews")
}

model Profile {
  userId                String             @id @map("user_id") @db.Uuid
  displayName           String             @map("display_name") @db.VarChar(80)
  avatarUrl             String?            @map("avatar_url") @db.VarChar(2048)
  avatarPublicId        String?            @map("avatar_public_id") @db.VarChar(255)
  bio                   String?            @db.VarChar(500)
  budgetMin             Int?               @map("budget_min")
  budgetMax             Int?               @map("budget_max")
  desiredAreas          String[]           @default([]) @map("desired_areas")
  desiredLocations      Json               @default("[]") @map("desired_locations")
  sleepSchedule         SleepSchedule?     @map("sleep_schedule")
  smokingPreference     SmokingPreference? @map("smoking_preference")
  petPreference         PetPreference?     @map("pet_preference")
  quietLevel            QuietLevel?        @map("quiet_level")
  visibility            ProfileVisibility  @default(PUBLIC)
  showBudget            Boolean            @default(true) @map("show_budget")
  showDesiredAreas      Boolean            @default(true) @map("show_desired_areas")
  showLifestyle         Boolean            @default(true) @map("show_lifestyle")
  onboardingCompletedAt DateTime?          @map("onboarding_completed_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visibility, updatedAt, userId])
  @@index([desiredLocations], type: Gin)
  @@map("profiles")
}

model Connection {
  id           String           @id @default(uuid()) @db.Uuid
  // Sorted UUIDs identify a pair regardless of who sends the request.
  pairKey      String           @unique @map("pair_key") @db.VarChar(73)
  senderId     String           @map("sender_id") @db.Uuid
  receiverId   String           @map("receiver_id") @db.Uuid
  status       ConnectionStatus @default(PENDING)
  message      String           @default("") @db.VarChar(500)
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  sender       User             @relation("ConnectionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
  @@map("connections")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum NotificationType {
  CONNECTION
  MESSAGE
  APPOINTMENT
  HOUSE
  SERVICE
}

model Conversation {
  id           String        @id @default(uuid()) @db.Uuid
  connectionId String        @unique @map("connection_id") @db.Uuid
  lastNumber   Int           @default(0) @map("last_number")
  senderRead   Int           @default(0) @map("sender_read")
  receiverRead Int           @default(0) @map("receiver_read")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  connection   Connection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messages     Message[]
  appointments Appointment[]

  @@map("conversations")
}

model Message {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  senderId       String              @map("sender_id") @db.Uuid
  clientId       String              @map("client_id") @db.Uuid
  number         Int
  text           String              @db.VarChar(2000)
  contentHash    String              @default("") @map("content_hash") @db.VarChar(64)
  version        Int                 @default(1)
  editedAt       DateTime?           @map("edited_at")
  deletedAt      DateTime?           @map("deleted_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]

  @@unique([conversationId, number])
  @@unique([conversationId, senderId, clientId])
  @@index([senderId, createdAt])
  @@map("messages")
}

enum MessageAttachmentKind {
  IMAGE
  AUDIO
  FILE
}

model MessageAttachment {
  id        String                @id @default(uuid()) @db.Uuid
  messageId String                @map("message_id") @db.Uuid
  kind      MessageAttachmentKind
  mimeType  String                @map("mime_type") @db.VarChar(50)
  byteSize  Int                   @map("byte_size")
  fileName  String?               @map("file_name") @db.VarChar(255)
  position  Int
  width     Int?
  height    Int?
  data      Bytes                 @db.ByteA
  message   Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, position])
  @@map("message_attachments")
}

model Appointment {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  listingId      String?             @map("listing_id") @db.Uuid
  proposerId     String              @map("proposer_id") @db.Uuid
  startsAt       DateTime            @map("starts_at") @db.Timestamptz(3)
  place          String              @db.VarChar(300)
  note           String              @default("") @db.VarChar(1000)
  status         AppointmentStatus   @default(PENDING)
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  listing        Listing?            @relation(fields: [listingId], references: [id], onDelete: SetNull)
  changes        AppointmentChange[]

  @@index([conversationId, startsAt])
  @@index([listingId, status, startsAt])
  @@map("appointments")
}

model AppointmentChange {
  id            String            @id @default(uuid()) @db.Uuid
  appointmentId String            @map("appointment_id") @db.Uuid
  actorId       String            @map("actor_id") @db.Uuid
  version       Int
  status        AppointmentStatus
  startsAt      DateTime          @map("starts_at") @db.Timestamptz(3)
  place         String            @db.VarChar(300)
  note          String            @db.VarChar(1000)
  createdAt     DateTime          @default(now()) @map("created_at")
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, version])
  @@map("appointment_changes")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(200)
  href           String           @db.VarChar(200)
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  emailRequired  Boolean          @default(false) @map("email_required")
  emailSentAt    DateTime?        @map("email_sent_at")
  emailAttempts  Int              @default(0) @map("email_attempts")
  emailNextAt    DateTime         @default(now()) @map("email_next_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  debtReminderId String?          @map("debt_reminder_id") @db.Uuid
  debtReminder   DebtReminder?    @relation(fields: [debtReminderId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([emailRequired, emailSentAt, emailNextAt])
  @@index([debtReminderId])
  @@map("notifications")
}

model ConnectionAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@map("connection_attempts")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  target    User     @relation("BlockedUser", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([blockerId, targetId])
  @@index([targetId, blockerId])
  @@map("user_blocks")
}

model UserReport {
  id           String           @id @default(uuid()) @db.Uuid
  reporterId   String           @map("reporter_id") @db.Uuid
  targetId     String           @map("target_id") @db.Uuid
  reason       UserReportReason
  details      String           @db.VarChar(1000)
  status       UserReportStatus @default(OPEN)
  createdAt    DateTime         @default(now()) @map("created_at")
  version      Int              @default(1)
  handledAt    DateTime?        @map("handled_at")
  handlingNote String?          @map("handling_note") @db.VarChar(1000)
  reporter     User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target       User             @relation("ReportedUser", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetId])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@map("user_reports")
}

enum AnnouncementKind {
  GENERAL
  MAINTENANCE
}

model SystemAnnouncement {
  id               String           @id @default(uuid()) @db.Uuid
  authorId         String           @map("author_id") @db.Uuid
  title            String           @db.VarChar(120)
  message          String           @db.VarChar(1000)
  kind             AnnouncementKind @default(GENERAL)
  displayFrom      DateTime         @map("display_from")
  displayUntil     DateTime         @map("display_until")
  maintenanceFrom  DateTime?        @map("maintenance_from")
  maintenanceUntil DateTime?        @map("maintenance_until")
  published        Boolean          @default(false)
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  author           User             @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([published, displayUntil, displayFrom])
  @@map("system_announcements")
}

model AdminAction {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.Uuid
  reason    String?  @db.VarChar(1000)
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at")
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityId, createdAt])
  @@map("admin_actions")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  lastActiveAt DateTime? @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleLoginStates GoogleLoginState[]

  @@index([userId, expiresAt])
  @@map("sessions")
}

// One current challenge per email and purpose, including unknown emails.
model AuthOtp {
  id           String        @id @default(uuid()) @db.Uuid
  challengeId  String        @unique @map("challenge_id") @db.Uuid
  email        String        @db.VarChar(320)
  type         AuthTokenType
  userId       String?       @map("user_id") @db.Uuid
  codeHash     String        @map("code_hash") @db.Char(64)
  attempts     Int           @default(0)
  expiresAt    DateTime      @map("expires_at")
  consumedAt   DateTime?     @map("consumed_at")
  lastSentAt   DateTime      @map("last_sent_at")
  sendWindowAt DateTime      @map("send_window_at")
  sendCount    Int           @map("send_count")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, type])
  @@index([expiresAt])
  @@map("auth_otps")
}

model AuthToken {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       AuthTokenType
  tokenHash  String        @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime      @map("expires_at")
  consumedAt DateTime?     @map("consumed_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@map("auth_tokens")
}

// Google sub is stable; email is not an account identifier.
model GoogleAccount {
  userId    String   @id @map("user_id") @db.Uuid
  googleId  String   @unique @map("google_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_accounts")
}

// Short-lived, one-use state shared by all backend instances.
model GoogleLoginState {
  stateHash        String   @id @map("state_hash") @db.Char(64)
  browserTokenHash String   @map("browser_token_hash") @db.Char(64)
  nonce            String   @db.VarChar(128)
  codeVerifier     String   @map("code_verifier") @db.VarChar(128)
  linkSessionId    String?  @map("link_session_id") @db.Uuid
  expiresAt        DateTime @map("expires_at")

  linkSession Session? @relation(fields: [linkSessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([linkSessionId])
  @@map("google_login_states")
}

// Khoản chi gốc.
model Expense {
  id      String @id @default(uuid()) @db.Uuid
  houseId String @map("house_id") @db.Uuid

  payerId     String @map("payer_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid

  clientId    String           @default(uuid()) @map("client_id") @db.VarChar(100)
  contentHash String           @default("") @map("content_hash") @db.VarChar(64)
  version     Int              @default(1)
  splitMode   ExpenseSplitMode @default(CUSTOM) @map("split_mode")
  title       String           @db.VarChar(150)
  description String?          @db.VarChar(2000)

  amount     Int
  receiptUrl String? @map("receipt_url") @db.VarChar(2048)

  status   ExpenseStatus   @default(ACTIVE)
  category ExpenseCategory @default(OTHER)
  spentOn  DateTime        @default(now()) @map("spent_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  house     House            @relation(fields: [houseId], references: [id], onDelete: Cascade)
  payer     HouseParticipant @relation("ExpensePayer", fields: [houseId, payerId], references: [houseId, id], onDelete: Restrict)
  createdBy User             @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  splits          ExpenseSplit[]
  adjustments     ExpenseAdjustment[]
  corrections     ExpenseCorrection[]
  receipt         ExpenseReceipt?
  recurringDraft  RecurringExpenseDraft?
  sharingPeriodId String?                @map("sharing_period_id") @db.Uuid
  sharingSnapshot Json?                  @map("sharing_snapshot")
  sharingPeriod   CostSharingPeriod?     @relation(fields: [houseId, sharingPeriodId], references: [houseId, id], onDelete: Restrict)

  @@unique([houseId, createdById, clientId])
  @@index([houseId, createdAt])
  @@index([houseId, spentOn, category])
  @@index([payerId])
  @@index([createdById])
  @@map("expenses")
}

// Phần tiền mỗi thành viên chịu cho khoản chi.
model ExpenseSplit {
  id            String @id @default(uuid()) @db.Uuid
  expenseId     String @map("expense_id") @db.Uuid
  houseId       String @map("house_id") @db.Uuid
  participantId String @map("user_id") @db.Uuid

  amount Int

  expense     Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  participant HouseParticipant @relation(fields: [houseId, participantId], references: [houseId, id], onDelete: Restrict)

  @@unique([expenseId, participantId])
  @@index([participantId])
  @@map("expense_splits")
}

// Một lần thành viên trả tiền bù trừ công nợ trong nhà.
model DebtPayment {
  id String @id @default(uuid()) @db.Uuid

  houseId     String @map("house_id") @db.Uuid
  payerId     String @map("payer_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  clientId String @map("client_id") @db.VarChar(100)

  amount Int
  method PaymentMethod
  status PaymentStatus @default(PENDING)

  note String? @db.VarChar(1000)

  createdAt     DateTime  @default(now()) @map("created_at")
  confirmedAt   DateTime? @map("confirmed_at")
  version       Int       @default(1)
  createdById   String    @map("created_by_id") @db.Uuid
  confirmedById String?   @map("confirmed_by_id") @db.Uuid
  contentHash   String    @default("") @map("content_hash") @db.VarChar(64)

  house       House             @relation(fields: [houseId], references: [id], onDelete: Cascade)
  payer       HouseParticipant  @relation("DebtPaymentsMade", fields: [houseId, payerId], references: [houseId, id], onDelete: Restrict)
  recipient   HouseParticipant  @relation("DebtPaymentsReceived", fields: [houseId, recipientId], references: [houseId, id], onDelete: Restrict)
  createdBy   User              @relation("PaymentRecorder", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy User?             @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  proof       DebtPaymentProof?

  @@unique([houseId, payerId, clientId])
  @@index([houseId, createdAt])
  @@index([payerId, status])
  @@index([recipientId, status])
  @@map("debt_payments")
}

// Ảnh minh chứng riêng tư, lưu cùng lần ghi nhận thanh toán.
model DebtPaymentProof {
  paymentId String      @id @map("payment_id") @db.Uuid
  data      Bytes       @db.ByteA
  mimeType  String      @default("image/jpeg") @map("mime_type") @db.VarChar(30)
  payment   DebtPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("debt_payment_proofs")
}

model DebtReminder {
  id             String           @id @default(uuid()) @db.Uuid
  houseId        String           @map("house_id") @db.Uuid
  participantId  String           @map("participant_id") @db.Uuid
  debtSinceAt    DateTime?        @map("debt_since_at")
  lastReminderAt DateTime?        @map("last_reminder_at")
  nextReminderAt DateTime?        @map("next_reminder_at")
  pausedUntil    DateTime?        @map("paused_until")
  unpaidAmount   Int              @default(0) @map("unpaid_amount")
  participant    HouseParticipant @relation(fields: [houseId, participantId], references: [houseId, id], onDelete: Cascade)
  notifications  Notification[]

  @@unique([houseId, participantId])
  @@index([nextReminderAt])
  @@map("debt_reminders")
}

model RepaymentPromise {
  houseId     String           @map("house_id") @db.Uuid
  payerId     String           @map("payer_id") @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  amount      Int
  payOn       DateTime         @map("pay_on") @db.Date
  remindAfter DateTime         @map("remind_after")
  version     Int              @default(1)
  updatedAt   DateTime         @updatedAt @map("updated_at")
  payer       HouseParticipant @relation("RepaymentPromiser", fields: [houseId, payerId], references: [houseId, id], onDelete: Cascade)
  recipient   HouseParticipant @relation("RepaymentPromiseRecipient", fields: [houseId, recipientId], references: [houseId, id], onDelete: Cascade)

  @@id([houseId, payerId, recipientId])
  @@map("repayment_promises")
}

// Lịch sử chỉnh sửa khoản chi.
model ExpenseAdjustment {
  id String @id @default(uuid()) @db.Uuid

  expenseId   String @map("expense_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid

  oldAmount Int @map("old_amount")
  newAmount Int @map("new_amount")

  reason      String @db.VarChar(1000)
  action      String @default("EDIT") @db.VarChar(30)
  version     Int    @default(1)
  oldSnapshot Json?  @map("old_snapshot")
  newSnapshot Json?  @map("new_snapshot")

  createdAt DateTime @default(now()) @map("created_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  createdBy User @relation("ExpenseAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([expenseId, createdAt])
  @@map("expense_adjustments")
}

// Account participants use their user ID; guests get an independent ID.
// The composite key keeps the same person distinct in each house's ledger.
model HouseParticipant {
  houseId               String                   @map("house_id") @db.Uuid
  id                    String                   @default(uuid()) @db.Uuid
  userId                String?                  @map("user_id") @db.Uuid
  displayName           String                   @map("display_name") @db.VarChar(120)
  leftAt                DateTime?                @map("left_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  house                 House                    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user                  User?                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  paidExpenses          Expense[]                @relation("ExpensePayer")
  splits                ExpenseSplit[]
  correctionShares      ExpenseCorrectionShare[]
  paymentsMade          DebtPayment[]            @relation("DebtPaymentsMade")
  paymentsReceived      DebtPayment[]            @relation("DebtPaymentsReceived")
  debtReminder          DebtReminder?
  repaymentPromises     RepaymentPromise[]       @relation("RepaymentPromiser")
  repaymentAppointments RepaymentPromise[]       @relation("RepaymentPromiseRecipient")
  activities            HouseActivity[]
  recurringExpenses     RecurringExpense[]

  @@id([houseId, id])
  @@unique([houseId, userId])
  @@map("house_participants")
}

// Append-only differences against a closed expense; the original stays unchanged.
model ExpenseCorrection {
  id          String                   @id @default(uuid()) @db.Uuid
  houseId     String                   @map("house_id") @db.Uuid
  expenseId   String                   @map("expense_id") @db.Uuid
  createdById String                   @map("created_by_id") @db.Uuid
  clientId    String                   @map("client_id") @db.VarChar(100)
  contentHash String                   @map("content_hash") @db.VarChar(64)
  version     Int
  reason      String                   @db.VarChar(1000)
  amountDelta Int                      @map("amount_delta")
  oldSnapshot Json                     @map("old_snapshot")
  newSnapshot Json                     @map("new_snapshot")
  recordedOn  DateTime                 @map("recorded_on") @db.Date
  createdAt   DateTime                 @default(now()) @map("created_at")
  settledAt   DateTime?                @map("settled_at")
  house       House                    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  expense     Expense                  @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  createdBy   User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  shares      ExpenseCorrectionShare[]

  @@unique([expenseId, version])
  @@unique([houseId, createdById, clientId])
  @@index([houseId, recordedOn])
  @@map("expense_corrections")
}

model ExpenseCorrectionShare {
  correctionId  String            @map("correction_id") @db.Uuid
  houseId       String            @map("house_id") @db.Uuid
  participantId String            @map("participant_id") @db.Uuid
  paidDelta     Int               @map("paid_delta")
  owedDelta     Int               @map("owed_delta")
  correction    ExpenseCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  participant   HouseParticipant  @relation(fields: [houseId, participantId], references: [houseId, id], onDelete: Restrict)

  @@id([correctionId, participantId])
  @@map("expense_correction_shares")
}

enum CostSharingMode {
  EQUAL
  WEIGHTED
}

enum CostSharingKind {
  MONTHLY
  DEFAULT
}

enum CostSharingStatus {
  OPEN
  AGREED
  FALLBACK
  UNRESOLVED
  NEEDS_REVIEW
}

enum CostSharingPhase {
  PREFERENCE
  PROPOSAL
}

enum CostSharingChoice {
  EQUAL
  WEIGHTED
  AGREE
  REJECT
}

model CostSharingSetting {
  houseId     String          @map("house_id") @db.Uuid
  category    ExpenseCategory
  deadlineDay Int             @default(7) @map("deadline_day")
  enabled     Boolean         @default(true)
  updatedAt   DateTime        @updatedAt @map("updated_at")
  house       House           @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@id([houseId, category])
  @@map("cost_sharing_settings")
}

model CostSharingPeriod {
  id               String             @id @default(uuid()) @db.Uuid
  houseId          String             @map("house_id") @db.Uuid
  category         ExpenseCategory
  month            String             @db.VarChar(7)
  kind             CostSharingKind
  status           CostSharingStatus  @default(OPEN)
  deadlineAt       DateTime           @map("deadline_at") @db.Timestamptz(3)
  currentRound     Int                @default(1) @map("current_round")
  resultMode       CostSharingMode?   @map("result_mode")
  resultShares     Json?              @map("result_shares")
  resultMemberHash String?            @map("result_member_hash") @db.Char(64)
  fallbackSnapshot Json?              @map("fallback_snapshot")
  decidedAt        DateTime?          @map("decided_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  house            House              @relation(fields: [houseId], references: [id], onDelete: Cascade)
  rounds           CostSharingRound[]
  expenses         Expense[]

  @@unique([houseId, id])
  // A partial unique index in the migration allows multiple DEFAULT discussions.
  @@index([houseId, month, category, kind])
  @@index([kind, status, deadlineAt])
  @@map("cost_sharing_periods")
}

model CostSharingRound {
  id          String                 @id @default(uuid()) @db.Uuid
  periodId    String                 @map("period_id") @db.Uuid
  number      Int
  phase       CostSharingPhase
  status      String                 @default("OPEN") @db.VarChar(16)
  resolvedAt  DateTime?              @map("resolved_at")
  memberHash  String                 @map("member_hash") @db.Char(64)
  members     Json
  mode        CostSharingMode?
  shares      Json?
  reason      String                 @default("") @db.VarChar(1000)
  createdById String?                @map("created_by_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at")
  period      CostSharingPeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  votes       CostSharingVote[]
  events      CostSharingVoteEvent[]

  @@unique([periodId, number])
  @@map("cost_sharing_rounds")
}

model CostSharingVote {
  roundId   String            @map("round_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  choice    CostSharingChoice
  version   Int               @default(1)
  updatedAt DateTime          @updatedAt @map("updated_at")
  round     CostSharingRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@id([roundId, userId])
  @@map("cost_sharing_votes")
}

model CostSharingVoteEvent {
  id        String            @id @default(uuid()) @db.Uuid
  roundId   String            @map("round_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  choice    CostSharingChoice
  version   Int
  createdAt DateTime          @default(now()) @map("created_at")
  round     CostSharingRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId, version])
  @@map("cost_sharing_vote_events")
}

model HouseActivity {
  id            String              @id @default(uuid()) @db.Uuid
  houseId       String              @map("house_id") @db.Uuid
  kind          HouseActivityKind
  title         String              @db.VarChar(150)
  note          String              @default("") @db.VarChar(2000)
  quantity      String              @default("") @db.VarChar(100)
  dueOn         DateTime?           @map("due_on") @db.Date
  assigneeId    String?             @map("assignee_id") @db.Uuid
  createdById   String              @map("created_by_id") @db.Uuid
  completedById String?             @map("completed_by_id") @db.Uuid
  completedAt   DateTime?           @map("completed_at")
  status        HouseActivityStatus @default(OPEN)
  version       Int                 @default(1)
  clientId      String              @map("client_id") @db.Uuid
  contentHash   String              @map("content_hash") @db.VarChar(64)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  house         House               @relation(fields: [houseId], references: [id], onDelete: Cascade)
  assignee      HouseParticipant?   @relation(fields: [houseId, assigneeId], references: [houseId, id], onDelete: Restrict)
  createdBy     User                @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy   User?               @relation("ActivityCompleter", fields: [completedById], references: [id], onDelete: Restrict)

  @@unique([houseId, createdById, clientId])
  @@index([houseId, kind, status, dueOn])
  @@map("house_activities")
}

model RecurringExpense {
  id             String                  @id @default(uuid()) @db.Uuid
  houseId        String                  @map("house_id") @db.Uuid
  createdById    String                  @map("created_by_id") @db.Uuid
  clientId       String                  @map("client_id") @db.Uuid
  contentHash    String                  @map("content_hash") @db.VarChar(64)
  title          String                  @db.VarChar(150)
  description    String                  @default("") @db.VarChar(2000)
  category       ExpenseCategory         @default(OTHER)
  amount         Int?
  payerId        String                  @map("payer_id") @db.Uuid
  participantIds String[]                @map("participant_ids") @db.Uuid
  dayOfMonth     Int                     @map("day_of_month")
  nextOn         DateTime                @map("next_on") @db.Date
  enabled        Boolean                 @default(true)
  version        Int                     @default(1)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  house          House                   @relation(fields: [houseId], references: [id], onDelete: Cascade)
  createdBy      User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  payer          HouseParticipant        @relation(fields: [houseId, payerId], references: [houseId, id], onDelete: Restrict)
  drafts         RecurringExpenseDraft[]

  @@unique([houseId, createdById, clientId])
  @@index([enabled, nextOn])
  @@map("recurring_expenses")
}

// A snapshot stays outside the ledger until an explicit, atomic confirmation.
model RecurringExpenseDraft {
  id             String               @id @default(uuid()) @db.Uuid
  ruleId         String               @map("rule_id") @db.Uuid
  dueOn          DateTime             @map("due_on") @db.Date
  title          String               @db.VarChar(150)
  description    String               @db.VarChar(2000)
  category       ExpenseCategory
  amount         Int?
  payerId        String               @map("payer_id") @db.Uuid
  participantIds String[]             @map("participant_ids") @db.Uuid
  status         RecurringDraftStatus @default(PENDING)
  version        Int                  @default(1)
  expenseId      String?              @unique @map("expense_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at")
  rule           RecurringExpense     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  expense        Expense?             @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([ruleId, dueOn])
  @@index([ruleId, status, dueOn])
  @@map("recurring_expense_drafts")
}

model ExpenseReceipt {
  expenseId String  @id @map("expense_id") @db.Uuid
  data      Bytes   @db.ByteA
  mimeType  String  @default("image/jpeg") @map("mime_type") @db.VarChar(50)
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@map("expense_receipts")
}

model HouseMessage {
  id          String                   @id @default(uuid()) @db.Uuid
  houseId     String                   @map("house_id") @db.Uuid
  senderId    String                   @map("sender_id") @db.Uuid
  clientId    String                   @map("client_id") @db.Uuid
  number      Int
  text        String                   @db.VarChar(2000)
  contentHash String                   @map("content_hash") @db.VarChar(64)
  version     Int                      @default(1)
  editedAt    DateTime?                @map("edited_at")
  deletedAt   DateTime?                @map("deleted_at")
  createdAt   DateTime                 @default(now()) @map("created_at")
  house       House                    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  sender      User                     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  attachments HouseMessageAttachment[]
  poll        HousePoll?

  @@unique([houseId, number])
  @@unique([houseId, senderId, clientId])
  @@index([senderId, createdAt])
  @@map("house_messages")
}

model HouseMessageAttachment {
  id        String                @id @default(uuid()) @db.Uuid
  messageId String                @map("message_id") @db.Uuid
  kind      MessageAttachmentKind
  mimeType  String                @map("mime_type") @db.VarChar(50)
  byteSize  Int                   @map("byte_size")
  fileName  String?               @map("file_name") @db.VarChar(255)
  position  Int
  width     Int?
  height    Int?
  data      Bytes                 @db.ByteA
  message   HouseMessage          @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, position])
  @@map("house_message_attachments")
}

model HousePoll {
  messageId String            @id @map("message_id") @db.Uuid
  question  String            @db.VarChar(200)
  closedAt  DateTime?         @map("closed_at") @db.Timestamptz(3)
  message   HouseMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options   HousePollOption[]
  votes     HousePollVote[]

  @@map("house_polls")
}

model HousePollOption {
  id       String          @id @default(uuid()) @db.Uuid
  pollId   String          @map("poll_id") @db.Uuid
  text     String          @db.VarChar(120)
  position Int
  poll     HousePoll       @relation(fields: [pollId], references: [messageId], onDelete: Cascade)
  votes    HousePollVote[]

  @@unique([pollId, id])
  @@unique([pollId, position])
  @@map("house_poll_options")
}

model HousePollVote {
  pollId   String          @map("poll_id") @db.Uuid
  userId   String          @map("user_id") @db.Uuid
  optionId String          @map("option_id") @db.Uuid
  poll     HousePoll       @relation(fields: [pollId], references: [messageId], onDelete: Cascade)
  option   HousePollOption @relation(fields: [pollId, optionId], references: [pollId, id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([pollId, optionId])
  @@map("house_poll_votes")
}

enum ServiceOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

model ServiceOrder {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  listingId         String                @map("listing_id") @db.Uuid
  postingRound      Int                   @default(1) @map("posting_round")
  clientId          String                @map("client_id") @db.Uuid
  planCode          String                @map("plan_code") @db.VarChar(50)
  planName          String                @map("plan_name") @db.VarChar(150)
  amount            Int
  durationDays      Int                   @map("duration_days")
  buyerName         String                @map("buyer_name") @db.VarChar(100)
  buyerEmail        String                @map("buyer_email") @db.VarChar(320)
  listingTitle      String                @map("listing_title") @db.VarChar(150)
  status            ServiceOrderStatus    @default(PENDING)
  provider          String                @default("MOMO_SANDBOX") @db.VarChar(30)
  providerOrderCode String?               @unique @map("provider_order_code") @db.VarChar(16)
  providerLinkId    String?               @map("provider_link_id") @db.VarChar(32)
  providerTransId   String?               @map("provider_trans_id") @db.VarChar(128)
  payUrl            String?               @map("pay_url") @db.VarChar(2000)
  checkoutLeaseAt   DateTime?             @map("checkout_lease_at")
  expiresAt         DateTime              @map("expires_at")
  paidAt            DateTime?             @map("paid_at")
  refundedAt        DateTime?             @map("refunded_at")
  payerBankId       String?               @map("payer_bank_id") @db.VarChar(50)
  payerBankName     String?               @map("payer_bank_name") @db.VarChar(100)
  payerAccount      String?               @map("payer_account") @db.VarChar(50)
  payerName         String?               @map("payer_name") @db.VarChar(100)
  resultCode        Int?                  @map("result_code")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  listing           Listing               @relation(fields: [listingId], references: [id], onDelete: Restrict)
  boost             ListingBoost?
  refund            ServiceRefundRequest?
  events            ServicePaymentEvent[]

  @@unique([userId, clientId])
  @@unique([provider, providerTransId])
  @@index([userId, createdAt, id])
  @@index([status, expiresAt])
  @@index([listingId, postingRound, status])
  @@map("service_orders")
}

model ListingBoost {
  id        String       @id @default(uuid()) @db.Uuid
  orderId   String       @unique @map("order_id") @db.Uuid
  listingId String       @map("listing_id") @db.Uuid
  startsAt  DateTime     @map("starts_at")
  endsAt    DateTime     @map("ends_at")
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  listing   Listing      @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([listingId, endsAt])
  @@map("listing_boosts")
}

model ServiceRefundRequest {
  id                     String                @id @default(uuid()) @db.Uuid
  orderId                String                @unique @map("order_id") @db.Uuid
  reason                 String                @db.VarChar(1000)
  amount                 Int
  status                 ServiceRefundStatus   @default(PENDING)
  source                 ServiceRefundSource   @default(USER)
  method                 ServiceRefundMethod   @default(MANUAL_BANK)
  version                Int                   @default(1)
  decisionNote           String?               @map("decision_note") @db.VarChar(1000)
  approvedAt             DateTime?             @map("approved_at")
  bankId                 String?               @map("bank_id") @db.VarChar(50)
  bankName               String?               @map("bank_name") @db.VarChar(100)
  accountNumber          String?               @map("account_number") @db.VarChar(50)
  accountName            String?               @map("account_name") @db.VarChar(100)
  differentAccountReason String?               @map("different_account_reason") @db.VarChar(1000)
  verifiedAt             DateTime?             @map("verified_at")
  verifiedById           String?               @map("verified_by_id") @db.Uuid
  verificationNote       String?               @map("verification_note") @db.VarChar(1000)
  verificationReference  String?               @map("verification_reference") @db.VarChar(200)
  processingAt           DateTime?             @map("processing_at")
  completedAt            DateTime?             @map("completed_at")
  refundReference        String?               @map("refund_reference") @db.VarChar(128)
  transferredAt          DateTime?             @map("transferred_at")
  lastError              String?               @map("last_error") @db.VarChar(1000)
  gatewayLeaseAt         DateTime?             @map("gateway_lease_at")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @default(now()) @updatedAt @map("updated_at")
  order                  ServiceOrder          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actions                ServiceRefundAction[]
  proofs                 ServiceRefundProof[]

  @@unique([method, refundReference])
  @@index([status, createdAt, id])
  @@map("service_refund_requests")
}

enum ServiceRefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum ServiceRefundMethod {
  MANUAL_BANK
  MOMO
}

enum ServiceRefundSource {
  USER
  SYSTEM
}

model ServiceRefundAction {
  id         String               @id @default(uuid()) @db.Uuid
  refundId   String               @map("refund_id") @db.Uuid
  actorId    String?              @map("actor_id") @db.Uuid
  action     String               @db.VarChar(50)
  fromStatus ServiceRefundStatus? @map("from_status")
  toStatus   ServiceRefundStatus  @map("to_status")
  note       String               @db.VarChar(1000)
  details    Json
  createdAt  DateTime             @default(now()) @map("created_at")
  refund     ServiceRefundRequest @relation(fields: [refundId], references: [id], onDelete: Cascade)
  actor      User?                @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([refundId, createdAt, id])
  @@map("service_refund_actions")
}

model ServiceRefundProof {
  id           String               @id @default(uuid()) @db.Uuid
  refundId     String               @map("refund_id") @db.Uuid
  uploadedById String               @map("uploaded_by_id") @db.Uuid
  data         Bytes
  mimeType     String               @map("mime_type") @db.VarChar(100)
  createdAt    DateTime             @default(now()) @map("created_at")
  refund       ServiceRefundRequest @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId, createdAt])
  @@map("service_refund_proofs")
}

model ServicePaymentEvent {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  signature  String       @unique @db.VarChar(64)
  resultCode Int          @map("result_code")
  transId    String       @map("trans_id") @db.VarChar(128)
  receivedAt DateTime     @default(now()) @map("received_at")
  order      ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, receivedAt])
  @@map("service_payment_events")
}
