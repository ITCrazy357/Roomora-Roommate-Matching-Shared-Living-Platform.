{$DOMAIN} {
  header Strict-Transport-Security "max-age=15552000"
  encode zstd gzip
  @mcpDiscovery path /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/api/v1/mcp
  handle @mcpDiscovery {
    reverse_proxy api:5000
  }
  handle /api/* {
    reverse_proxy api:5000 {
      # Flush SSE events immediately.
      flush_interval -1
    }
  }
  handle {
    reverse_proxy frontend:3000
  }
}
