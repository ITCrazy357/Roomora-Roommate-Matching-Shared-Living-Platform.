generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum SleepSchedule {
  EARLY_BIRD
  FLEXIBLE
  NIGHT_OWL
}

enum SmokingPreference {
  NO_SMOKING
  OUTDOOR_ONLY
  SMOKER
}

enum PetPreference {
  NO_PETS
  PET_FRIENDLY
  HAS_PETS
}

enum QuietLevel {
  QUIET
  BALANCED
  SOCIAL
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  CLOSED
}

enum Amenity {
  FURNISHED
  AIR_CONDITIONER
  WASHING_MACHINE
  PARKING
  WIFI
  KITCHEN
  BALCONY
  PRIVATE_BATHROOM
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum UserReportReason {
  SPAM
  HARASSMENT
  SCAM
  INAPPROPRIATE
  OTHER
}

enum UserReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  role            UserRole  @default(USER)
  email           String    @unique @db.VarChar(320)
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  profile             Profile?
  sessions            Session[]
  authTokens          AuthToken[]
  googleAccount       GoogleAccount?
  listings            Listing[]           @relation("ListingOwner")
  savedListings       SavedListing[]
  listingReviews      ListingReview[]
  sentConnections     Connection[]        @relation("ConnectionSender")
  receivedConnections Connection[]        @relation("ConnectionReceiver")
  connectionAttempts  ConnectionAttempt[]
  blockedUsers        UserBlock[]         @relation("Blocker")
  blockedBy           UserBlock[]         @relation("BlockedUser")
  sentReports         UserReport[]        @relation("Reporter")
  receivedReports     UserReport[]        @relation("ReportedUser")

  @@map("users")
}

model Listing {
  id                String             @id @default(uuid()) @db.Uuid
  ownerId           String             @map("owner_id") @db.Uuid
  status            ListingStatus      @default(DRAFT)
  version           Int                @default(1)
  title             String             @default("") @db.VarChar(150)
  description       String             @default("") @db.VarChar(5000)
  rent              Int?
  deposit           Int                @default(0)
  electricityCost   Int                @default(0) @map("electricity_cost")
  waterCost         Int                @default(0) @map("water_cost")
  internetCost      Int                @default(0) @map("internet_cost")
  otherCost         Int                @default(0) @map("other_cost")
  costNote          String             @default("") @map("cost_note") @db.VarChar(500)
  area              Int?
  availableSlots    Int                @default(1) @map("available_slots")
  currentResidents  Int                @default(0) @map("current_residents")
  availableFrom     DateTime?          @map("available_from") @db.Date
  provinceCode      String?            @map("province_code") @db.VarChar(2)
  provinceName      String?            @map("province_name") @db.VarChar(100)
  wardCode          String?            @map("ward_code") @db.VarChar(5)
  wardName          String?            @map("ward_name") @db.VarChar(100)
  privateAddress    String             @default("") @map("private_address") @db.VarChar(300)
  // Only a coarse area center is stored; never precise room coordinates.
  latitude          Float?
  longitude         Float?
  amenities         Amenity[]          @default([])
  roommateNote      String             @default("") @map("roommate_note") @db.VarChar(1000)
  smokingPreference SmokingPreference? @map("smoking_preference")
  petPreference     PetPreference?     @map("pet_preference")
  quietLevel        QuietLevel?        @map("quiet_level")
  rejectionReason   String?            @map("rejection_reason") @db.VarChar(1000)
  submittedAt       DateTime?          @map("submitted_at")
  publishedAt       DateTime?          @map("published_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  owner   User            @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  photos  ListingPhoto[]
  saves   SavedListing[]
  reviews ListingReview[]

  @@index([status, publishedAt, id])
  @@index([status, provinceCode, wardCode, rent])
  @@index([ownerId, updatedAt])
  @@index([amenities], type: Gin)
  @@map("listings")
}

model ListingPhoto {
  id        String  @id @default(uuid()) @db.Uuid
  listingId String  @map("listing_id") @db.Uuid
  url       String  @db.VarChar(2048)
  publicId  String  @unique @map("public_id") @db.VarChar(255)
  position  Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
  @@map("listing_photos")
}

model SavedListing {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId, createdAt])
  @@map("saved_listings")
}

model ListingReview {
  id        String        @id @default(uuid()) @db.Uuid
  listingId String        @map("listing_id") @db.Uuid
  adminId   String        @map("admin_id") @db.Uuid
  decision  ListingStatus
  reason    String?       @db.VarChar(1000)
  version   Int
  createdAt DateTime      @default(now()) @map("created_at")
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  admin     User          @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt])
  @@map("listing_reviews")
}

model Profile {
  userId                String             @id @map("user_id") @db.Uuid
  displayName           String             @map("display_name") @db.VarChar(80)
  avatarUrl             String?            @map("avatar_url") @db.VarChar(2048)
  avatarPublicId        String?            @map("avatar_public_id") @db.VarChar(255)
  bio                   String?            @db.VarChar(500)
  budgetMin             Int?               @map("budget_min")
  budgetMax             Int?               @map("budget_max")
  desiredAreas          String[]           @default([]) @map("desired_areas")
  desiredLocations      Json               @default("[]") @map("desired_locations")
  sleepSchedule         SleepSchedule?     @map("sleep_schedule")
  smokingPreference     SmokingPreference? @map("smoking_preference")
  petPreference         PetPreference?     @map("pet_preference")
  quietLevel            QuietLevel?        @map("quiet_level")
  visibility            ProfileVisibility  @default(PUBLIC)
  showBudget            Boolean            @default(true) @map("show_budget")
  showDesiredAreas      Boolean            @default(true) @map("show_desired_areas")
  showLifestyle         Boolean            @default(true) @map("show_lifestyle")
  onboardingCompletedAt DateTime?          @map("onboarding_completed_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visibility, updatedAt, userId])
  @@index([desiredLocations], type: Gin)
  @@map("profiles")
}

model Connection {
  id         String           @id @default(uuid()) @db.Uuid
  // Sorted UUIDs identify a pair regardless of who sends the request.
  pairKey    String           @unique @map("pair_key") @db.VarChar(73)
  senderId   String           @map("sender_id") @db.Uuid
  receiverId String           @map("receiver_id") @db.Uuid
  status     ConnectionStatus @default(PENDING)
  message    String           @default("") @db.VarChar(500)
  version    Int              @default(1)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  sender     User             @relation("ConnectionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
  @@map("connections")
}

model ConnectionAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@map("connection_attempts")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  target    User     @relation("BlockedUser", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([blockerId, targetId])
  @@index([targetId, blockerId])
  @@map("user_blocks")
}

model UserReport {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @map("reporter_id") @db.Uuid
  targetId   String           @map("target_id") @db.Uuid
  reason     UserReportReason
  details    String           @db.VarChar(1000)
  status     UserReportStatus @default(OPEN)
  createdAt  DateTime         @default(now()) @map("created_at")
  reporter   User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target     User             @relation("ReportedUser", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetId])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@map("user_reports")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleLoginStates GoogleLoginState[]

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuthToken {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       AuthTokenType
  tokenHash  String        @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime      @map("expires_at")
  consumedAt DateTime?     @map("consumed_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@map("auth_tokens")
}

// Google sub is stable; email is not an account identifier.
model GoogleAccount {
  userId    String   @id @map("user_id") @db.Uuid
  googleId  String   @unique @map("google_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_accounts")
}

// Short-lived, one-use state shared by all backend instances.
model GoogleLoginState {
  stateHash        String   @id @map("state_hash") @db.Char(64)
  browserTokenHash String   @map("browser_token_hash") @db.Char(64)
  nonce            String   @db.VarChar(128)
  codeVerifier     String   @map("code_verifier") @db.VarChar(128)
  linkSessionId    String?  @map("link_session_id") @db.Uuid
  expiresAt        DateTime @map("expires_at")

  linkSession Session? @relation(fields: [linkSessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([linkSessionId])
  @@map("google_login_states")
}
